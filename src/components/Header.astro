---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;
const isActive = (prefix: string) => {
	if (prefix === '/') return pathname === '/';
	return pathname === prefix || pathname.startsWith(prefix);
};

const links = [
	{ href: '/tags/', label: 'Tags' },
	{ href: '/archive/', label: 'Archive' },
	{ href: '/about/', label: 'About' },
	{ href: '/rss.xml', label: 'RSS', external: true },
];
---

<header>
	<nav>
		<a href="/" class="brand">
			<img src="/logo-cat.png" alt="" width="28" height="28" />
			<span>{SITE_TITLE}</span>
		</a>
		<ul class="links">
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						class:list={[{ active: !link.external && isActive(link.href) }]}
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 1.25em 1em;
		background: #0e0e0e;
	}
	nav {
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75em 1.5em;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		text-decoration: none;
		color: #ffffff;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
	.brand img {
		display: block;
		filter: invert(1);
	}
	.links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25em 1.25em;
		font-size: 0.95em;
	}
	.links a {
		text-decoration: none;
		color: #9a948a;
		letter-spacing: 0.02em;
	}
	.links a:hover {
		color: #ffffff;
	}
	.links a.active {
		color: #ffffff;
	}
	@media (max-width: 480px) {
		.links {
			width: 100%;
			gap: 0.25em 1em;
			font-size: 0.9em;
		}
	}
</style>
