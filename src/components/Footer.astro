---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<small>&copy; {today.getFullYear()} {SITE_TITLE}</small>
</footer>
<style>
	footer {
		padding: 3em 1em 3em 1em;
		color: var(--color-muted);
		text-align: center;
		border-top: 1px solid var(--color-rule);
	}
</style>
