---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('posts')).filter((post) => post.data.draft === false);

const counts = new Map<number, number>();
for (const post of posts) {
	const y = post.data.published.getFullYear();
	counts.set(y, (counts.get(y) ?? 0) + 1);
}

const years = Array.from(counts.entries())
	.map(([year, count]) => ({ year, count }))
	.sort((a, b) => b.year - a.year);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`アーカイブ | ${SITE_TITLE}`} description={`${SITE_TITLE} のアーカイブ`} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>アーカイブ</h1>
			</section>

			{years.length === 0 ? (
				<p class="empty">記事はまだありません。</p>
			) : (
				<ul class="year-list">
					{years.map(({ year, count }) => (
						<li class="year-item">
							<a href={`/archive/${year}/`}>
								<span class="year">{year}</span>
								<span class="count">({count})</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		margin: 0 0 3em 0;
		padding-bottom: 1.5em;
		border-bottom: 1px solid var(--color-rule);
	}
	.page-header h1 {
		margin: 0;
		font-size: 1.75rem;
	}
	.empty {
		color: var(--color-muted);
	}
	.year-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.year-item {
		padding: 1em 0;
		border-top: 1px solid var(--color-rule);
	}
	.year-item:last-child {
		border-bottom: 1px solid var(--color-rule);
	}
	.year-item a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.6em;
		text-decoration: none;
		color: var(--color-fg);
	}
	.year-item a:hover .year {
		color: var(--color-muted);
	}
	.year {
		font-size: 1.25rem;
		letter-spacing: 0.04em;
	}
	.count {
		font-size: 0.9em;
		color: var(--color-muted);
	}
</style>
